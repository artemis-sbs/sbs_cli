import zipapp
import click
import subprocess
import shutil
import os
from src.version import VERSION


def run_cmd(cmd):
    try:
        if os.system(cmd)!=0:
            raise Exception(f"ERROR: running {cmd}")
    except Exception as e:
        raise

    return True

#
# This removes the PIP info folders
# and any pycache files
# These are not needed for the pyz and waste space
# also bin
#
def exclude_unnecessary(path):
    """Excludes __pycache__ directories and their contents."""
    path = str(path)
    if "__pycache__\\" in path or path.endswith("\\__pycache__") or path == "__pycache__":
        #print(f"Excluding: {path}")
        return False
    if ".dist-info\\" in path:
        #print(f"Excluding: {path}")
        return False
    if "bin\\" in path or path.endswith("\\bin") or path=="bin":
        #print(f"Excluding: {path}")
        return False
    return True

def create_app():
    try:
        output_dir = 'dist'
        output_file = os.path.join(output_dir, 'sbs.pyz')

        # Ensure the output directory exists
        if not os.path.exists(output_dir):
            os.makedirs(output_dir)

        zipapp.create_archive("__build__", target=output_file, main="main:cli", filter=exclude_unnecessary, compressed=True)
        print(f"Created app {output_file}")
    except Exception as e:
        print(f"Failed to create app {e}")


def install_cmd(dev):
    try:
        if dev:
            subprocess.run(["python", "-m" "pip", "install",  "-r", "requirements.txt"]) 
        else:
            subprocess.run(["python", "-m" "pip", "install",  "-r", "requirements.txt", "--target", "__build__"]) 
    except Exception as e:
        print(f"oops {e}")


@click.group()
def cli():
    pass

@cli.command()
@click.option('-i', '--install', is_flag=True)
def build(install):
    try:
        if install:
            install_cmd(False)
        #subprocess.run(["copy", "main.py", "fetch\\main.py"])
        shutil.copytree("src", "__build__", dirs_exist_ok=True)
        shutil.copytree("bat", "dist", dirs_exist_ok=True)
        create_app()
    except Exception as e:
        print(f"oops {e}")




@cli.command("install")
@click.option('-d', '--dev', is_flag=True)
def install(dev):
    install_cmd(dev)


@cli.command("version")
def version():
    print(f"{VERSION}")


@cli.command("release")
@click.argument('message', required=False)
@click.option('-v', '--version', default=VERSION)
@click.option('-u', '--unrelease', is_flag=True)
def release(version, message, unrelease):

    if unrelease:
        run_cmd(f"git tag --delete {version}")
        run_cmd(f"git push --delete origin {version}")

    if message is not None:
        # git tag -a %VERSION% -m %2
        run_cmd(f"git tag -a {version} -m \"{message}\"")
        # git push --tags
        run_cmd(f"git push --tags")



if __name__ == '__main__':
    cli()
