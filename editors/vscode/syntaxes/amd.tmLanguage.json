{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "AMD",
  "scopeName": "source.amd",
  "patterns": [
    {
      "include": "#boneyard"
    },
    {
      "include": "#comment"
    },
    {
      "include": "#fence"
    },
    {
      "include": "#heading"
    },
    {
      "include": "#synopsis"
    },
    {
      "include": "#choice"
    },
    {
      "include": "#cue"
    },
    {
      "include": "#direction"
    },
    {
      "include": "#callout"
    },
    {
      "include": "#dialogue"
    },
    {
      "include": "#wikilink"
    },
    {
      "include": "#color"
    }
  ],
  "repository": {
    "boneyard": {
      "begin": "^[ \\t]*/\\*",
      "end": "\\*/",
      "name": "comment.block.amd"
    },
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.amd"
    },
    "fence": {
      "begin": "^\\s*-{3,}\\s*$",
      "end": "^\\s*-{3,}\\s*$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.metadata.amd"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.metadata.amd"
        }
      },
      "name": "meta.metadata.amd",
      "patterns": [
        {
          "match": "^\\s*//.*$",
          "name": "comment.line.double-slash.amd"
        },
        {
          "match": "\\A\\s*([A-Za-z][A-Za-z0-9_-]*)\\s*$",
          "captures": {
            "1": {
              "name": "entity.name.type.amd"
            }
          }
        },
        {
          "match": "^(\\s*)([A-Za-z][A-Za-z0-9 _-]*?)(:)(.*)$",
          "captures": {
            "2": {
              "name": "variable.other.property.amd"
            },
            "3": {
              "name": "punctuation.separator.key-value.amd"
            },
            "4": {
              "name": "string.unquoted.amd"
            }
          }
        },
        {
          "match": "^\\s+(-)\\s+(.*)$",
          "captures": {
            "1": {
              "name": "punctuation.definition.list.amd"
            },
            "2": {
              "name": "string.unquoted.amd"
            }
          }
        },
        {
          "match": "^\\s+[^:\n]+$",
          "name": "string.unquoted.continuation.amd"
        }
      ]
    },
    "heading": {
      "match": "^(#+)[ \\t]+(?:(\\[)([^\\]]*)(\\])(\\()([^)]*)(\\)))?[ \\t]*(.*)$",
      "captures": {
        "1": {
          "name": "punctuation.definition.heading.amd"
        },
        "3": {
          "name": "entity.name.section.amd"
        },
        "6": {
          "name": "support.constant.property-value.amd"
        },
        "8": {
          "name": "markup.heading.amd"
        }
      },
      "name": "markup.heading.amd"
    },
    "synopsis": {
      "match": "^([ \\t]*=[ \\t])(.*)$",
      "captures": {
        "1": {
          "name": "punctuation.definition.comment.amd"
        },
        "2": {
          "name": "comment.line.synopsis.amd"
        }
      }
    },
    "choice": {
      "match": "^([ \\t]*-[ \\t]*)(\\[)([^\\]]*)(\\])(\\()([^)]*)(\\))(.*)$",
      "captures": {
        "1": {
          "name": "punctuation.definition.list.begin.amd"
        },
        "3": {
          "name": "string.other.link.title.amd"
        },
        "6": {
          "name": "support.constant.property-value.amd"
        },
        "8": {
          "name": "meta.outcome.amd"
        }
      }
    },
    "cue": {
      "match": "^([ \\t]*@)([\\w.-]+)[ \\t]*(\\([^)]*\\))?[ \\t]*$",
      "captures": {
        "1": {
          "name": "punctuation.definition.tag.amd"
        },
        "2": {
          "name": "entity.name.function.cue.amd"
        },
        "3": {
          "name": "support.type.property-name.amd"
        }
      }
    },
    "direction": {
      "match": "^[ \\t]*(\\([^)]*\\))[ \\t]*$",
      "captures": {
        "1": {
          "name": "support.type.property-name.amd"
        }
      }
    },
    "callout": {
      "match": "^([ \\t]*>)[ \\t]*(\\[!)([A-Za-z]+)(\\])[ \\t]*(.*)$",
      "captures": {
        "1": {
          "name": "punctuation.definition.quote.amd"
        },
        "2": {
          "name": "punctuation.definition.tag.amd"
        },
        "3": {
          "name": "entity.name.type.callout.amd"
        },
        "4": {
          "name": "punctuation.definition.tag.amd"
        },
        "5": {
          "name": "markup.bold.amd"
        }
      }
    },
    "dialogue": {
      "match": "^([ \\t]*%+)(.*)$",
      "captures": {
        "1": {
          "name": "punctuation.definition.quote.amd"
        },
        "2": {
          "name": "string.quoted.other.amd",
          "patterns": [
            {
              "include": "#wikilink"
            }
          ]
        }
      }
    },
    "wikilink": {
      "match": "(\\[\\[)([^\\]|\\r\\n]+?)(?:(\\|)([^\\]\\r\\n]*?))?(\\]\\])",
      "captures": {
        "1": {
          "name": "punctuation.definition.link.amd"
        },
        "2": {
          "name": "support.constant.property-value.amd"
        },
        "3": {
          "name": "punctuation.separator.amd"
        },
        "4": {
          "name": "string.other.link.title.amd"
        },
        "5": {
          "name": "punctuation.definition.link.amd"
        }
      }
    },
    "color": {
      "match": "#[0-9A-Fa-f]{3,8}\\b",
      "name": "constant.other.color.amd"
    }
  }
}
