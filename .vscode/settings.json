{
  // Mirrors sbs_utils: unittest, discovery from the folder root (-s .) so the
  // tests nest under the "sbs_cli" node in Test Explorer. (pytest not installed.)
  "python.testing.unittestEnabled": true,
  "python.testing.pytestEnabled": false,
  "python.testing.unittestArgs": [
    "-v",
    "-s",
    ".",
    "-p",
    "test_*.py"
  ],
  // src uses flat absolute imports (from file_help import ...); put it on the
  // analysis path so Pylance resolves them.
  "python.analysis.extraPaths": [
    "./src"
  ]
}
